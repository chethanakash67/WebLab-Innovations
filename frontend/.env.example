BACKEND_PUBLIC_URL=http://localhost:10000

# Compatibility fallback for older direct-client API builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:10000

# Optional sign-in gate for the Lab chat bot. Leave unset to let anyone chat
# without signing in; set both to require a Google sign-in before chatting.
AUTH_SECRET=generate_a_long_random_secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
