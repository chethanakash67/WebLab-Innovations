NODE_ENV=development
PORT=10000

# Use the internal Render PostgreSQL connection string in production.
DATABASE_URL=postgresql://user:password@localhost:5432/aigleonlabs
DATABASE_SSL=false

# Comma-separated frontend origins allowed to call this API.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:10000

# Mail delivery and review approvals.
REVIEW_SECRET=change-this-long-random-review-secret

EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_CONTACT_TEMPLATE_ID=template_contact
EMAILJS_REVIEW_TEMPLATE_ID=template_review
MAIL_TIMEOUT_MS=10000

CONTACT_TO=hello@theaigleonlabs.dev
REVIEW_TO=hello@theaigleonlabs.dev
