NODE_ENV=development
PORT=10000

# Use the internal Render PostgreSQL connection string in production.
DATABASE_URL=postgresql://user:password@localhost:5432/weblab
DATABASE_SSL=false

# Comma-separated frontend origins allowed to call this API.
FRONTEND_URL=http://localhost:3000

# OTP and mail delivery.
OTP_SECRET=change-this-long-random-secret
OTP_TTL_MINUTES=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@example.com
SMTP_PASS=your-email-app-password-or-otp
MAIL_FROM=WebLab <hello@example.com>
CONTACT_TO=hello@weblab.agency
