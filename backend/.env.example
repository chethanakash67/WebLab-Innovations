NODE_ENV=development
PORT=10000

# Use the internal Render PostgreSQL connection string in production.
DATABASE_URL=postgresql://user:password@localhost:5432/aigleonlabs
DATABASE_SSL=false

# Comma-separated frontend origins allowed to call this API.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:10000

# Mail delivery and review approvals.
REVIEW_SECRET=change-this-long-random-review-secret

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=AigleOn Labs <onboarding@resend.dev>
MAIL_TIMEOUT_MS=10000

CONTACT_TO=hello@theaigleonlabs.dev
REVIEW_TO=hello@theaigleonlabs.dev

# Lab Q&A assistant. Embeddings always run on Gemini (needs GEMINI_API_KEY).
# Answer generation falls back across Groq -> Gemini -> Cohere, 5 models each (15 total) —
# only providers with a key set are used, and each provider's model list can be
# overridden with a comma-separated GROQ_CHAT_MODELS / GEMINI_CHAT_MODELS / COHERE_CHAT_MODELS.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBEDDING_MODEL=embed-v4.0

# Only these emails can upload documents / retrain the Lab assistant.
LAB_ADMIN_EMAILS=saividesh29@gmail.com,chethanakash67@gmail.com
LAB_ADMIN_SECRET=change-this-long-random-lab-admin-secret
LAB_ADMIN_OTP_TTL_MINUTES=10
LAB_MAX_UPLOAD_MB=15
